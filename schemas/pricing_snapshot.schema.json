{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinatalediego.github.io/data_science_systems/schemas/pricing_snapshot.schema.json",
  "title": "Historical pricing project snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_date",
    "activity_month",
    "project_id",
    "project_name",
    "total_units",
    "available_units",
    "for_sale_units_apr",
    "sold_units_apr",
    "estimated_available_value_pen",
    "available_price_m2_usd",
    "sold_price_m2_usd",
    "average_sold_unit_price_pen",
    "exchange_rate",
    "separations_month",
    "minutas_month",
    "sales_value_month_pen",
    "pipeline_units_month",
    "pipeline_value_month_pen",
    "source_label"
  ],
  "properties": {
    "snapshot_date": { "type": "string", "format": "date" },
    "activity_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "project_id": { "type": "string", "minLength": 1 },
    "project_name": { "type": "string", "minLength": 1 },
    "phase": { "type": "string" },
    "total_units": { "type": "integer", "minimum": 0 },
    "available_units": { "type": "integer", "minimum": 0 },
    "for_sale_units_apr": { "type": "integer", "minimum": 0 },
    "sold_units_apr": { "type": "integer", "minimum": 0 },
    "estimated_available_value_pen": { "type": "number", "minimum": 0 },
    "available_price_m2_usd": { "type": "number", "exclusiveMinimum": 0 },
    "sold_price_m2_usd": { "type": "number", "exclusiveMinimum": 0 },
    "average_sold_unit_price_pen": { "type": "number", "minimum": 0 },
    "estimated_sold_value_pen": { "type": "number", "minimum": 0 },
    "exchange_rate": { "type": "number", "exclusiveMinimum": 0 },
    "average_available_unit_price_pen": { "type": "number", "minimum": 0 },
    "separations_month": { "type": "integer", "minimum": 0 },
    "minutas_month": { "type": "integer", "minimum": 0 },
    "sales_value_month_pen": { "type": "number", "minimum": 0 },
    "pipeline_units_month": { "type": "integer", "minimum": 0 },
    "pipeline_value_month_pen": { "type": "number", "minimum": 0 },
    "presale_considered_units": { "type": ["number", "null"], "minimum": 0 },
    "parking_available": { "type": "integer", "minimum": 0 },
    "parking_required": { "type": "number", "minimum": 0 },
    "source_pages": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "source_label": { "type": "string", "minLength": 1 }
  }
}
