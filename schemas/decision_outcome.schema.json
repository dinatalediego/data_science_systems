{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinatalediego.github.io/data_science_systems/schemas/decision_outcome.schema.json",
  "title": "Pricing decision outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "project_id", "adopted_at", "recorded_at", "price_adjustment_pct", "projected", "actual"],
  "properties": {
    "experiment_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "adopted_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "price_adjustment_pct": { "type": "number", "minimum": -100 },
    "elasticity_assumption": { "type": ["number", "null"] },
    "projected": {
      "type": "object",
      "required": ["minutas", "sales_value_pen", "months_stock", "price_m2_pen"],
      "properties": {
        "minutas": { "type": "number", "minimum": 0 },
        "sales_value_pen": { "type": "number", "minimum": 0 },
        "months_stock": { "type": "number", "minimum": 0 },
        "price_m2_pen": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "actual": {
      "type": "object",
      "required": ["minutas", "sales_value_pen", "stock_end", "price_m2_pen"],
      "properties": {
        "minutas": { "type": "number", "minimum": 0 },
        "sales_value_pen": { "type": "number", "minimum": 0 },
        "stock_end": { "type": "number", "minimum": 0 },
        "price_m2_pen": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "comparable_group_id": { "type": ["string", "null"] },
    "causal_design": { "type": "string", "enum": ["none", "matched", "randomized", "staggered"] }
  }
}
